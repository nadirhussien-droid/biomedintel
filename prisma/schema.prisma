// BiomedIntel.ai — database schema
//
// Source of truth: Stage 2 Technical Blueprint, section 4.
//   Stage 3: tenancy, people and access, authentication and audit.
//   Stage 4: equipment — locations, manufacturers, categories, models, assets,
//            asset status history and warranties.
// Maintenance, inventory, documents and AI tables come in later stages.
//
// Rules that apply to every tenant table (see prisma/migrations/*_security):
//   • `organization_id` on every row, with Row-Level Security (RLS) policies.
//   • Composite foreign keys (organization_id, x_id) so a row can never point at
//     another organisation's record.
//   • No hard deletes of operational records: `archived_at` / status instead.
//   • No patient data anywhere.

generator client {
  provider = "prisma-client"
  output   = "../server/db/generated"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

/// Roles a user can hold inside ONE organisation (a membership).
/// The Platform Super Administrator is NOT a membership role; it lives on the
/// user record (`platform_role`) and is set only by the bootstrap script.
enum MembershipRole {
  ORG_ADMIN // 2. Hospital Organization Administrator
  ENGINEERING_MANAGER // 3. Hospital Biomedical Engineering Manager
  TECHNICIAN // 4. Biomedical Engineer or Technician
  INVENTORY_MANAGER // 5. Inventory Manager
  DEPARTMENT_HEAD // 6. Department Head or Facility Manager
  AUDITOR // 7. Read-only Auditor or Executive
  FAULT_REPORTER // 8. Fault Reporter (nurses and ward staff)

  @@map("membership_role")
}

enum RecordStatus {
  ACTIVE
  ARCHIVED

  @@map("record_status")
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED

  @@map("organization_status")
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REVOKED

  @@map("membership_status")
}

/// Operational status of a device (Stage 2 definitions). Archiving is separate
/// (`archived_at`): an archived asset keeps its last operational status.
enum AssetStatus {
  IN_SERVICE
  UNDER_REPAIR // shown as "Under repair / maintenance"
  OUT_OF_SERVICE
  DECOMMISSIONED

  @@map("asset_status")
}

/// Organisation-assigned maintenance risk category (Stage 2 `risk_class`).
/// Not a regulatory device class; NULL means "not assessed".
enum RiskClass {
  HIGH
  MEDIUM
  LOW

  @@map("risk_class")
}

enum WarrantyKind {
  WARRANTY
  SERVICE_CONTRACT

  @@map("warranty_kind")
}

/// Stage 2 lifecycle_events. Stage 4 uses DECOMMISSION (request + NUM approval);
/// commissioning, EOL flags and disposal arrive with the lifecycle module.
enum LifecycleEventType {
  DECOMMISSION

  @@map("lifecycle_event_type")
}

enum LifecycleEventStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@map("lifecycle_event_status")
}

// ─── Work orders (Stage 5) ───────────────────────────────────────────────────

/// Stage 2 work order types. Stage 5 creates CORRECTIVE jobs (fault reports);
/// the others arrive with preventive maintenance and testing (Stage 6).
enum WorkOrderType {
  CORRECTIVE
  PREVENTIVE
  SAFETY_TEST
  CALIBRATION
  INSPECTION
  ACCEPTANCE

  @@map("work_order_type")
}

enum WorkOrderPriority {
  URGENT
  HIGH
  MEDIUM
  LOW

  @@map("work_order_priority")
}

enum WorkOrderStatus {
  REQUESTED // reported, waiting for a technician
  ASSIGNED
  IN_PROGRESS
  ON_HOLD // e.g. waiting for parts or the supplier
  COMPLETED // signed off by the technician who did the job
  CANCELLED

  @@map("work_order_status")
}

enum WorkOrderOutcome {
  REPAIRED
  NO_FAULT_FOUND
  NOT_REPAIRABLE

  @@map("work_order_outcome")
}

enum CheckResult {
  PASS
  FAIL
  NOT_APPLICABLE

  @@map("check_result")
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE

  @@map("audit_outcome")
}

// ─── Tenancy ─────────────────────────────────────────────────────────────────

/// A customer: a hospital group, NGO network or a single hospital.
model Organization {
  id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  slug       String             @unique
  country    String?            @db.Char(2) // ISO 3166-1 alpha-2, e.g. "KE"
  status     OrganizationStatus @default(ACTIVE)
  archivedAt DateTime?          @map("archived_at") @db.Timestamptz(6)
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  hospitals           Hospital[]
  departments         Department[]
  memberships         Membership[]
  membershipScopes    MembershipScope[]
  locations           Location[]
  manufacturers       Manufacturer[]
  equipmentCategories EquipmentCategory[]
  equipmentModels     EquipmentModel[]
  assets              Asset[]
  assetStatusHistory  AssetStatusHistory[]
  warranties          Warranty[]
  lifecycleEvents     LifecycleEvent[]
  workOrders          WorkOrder[]
  workOrderEvents     WorkOrderEvent[]
  workOrderTasks      WorkOrderTask[]
  attachments         Attachment[]
  downtimeEvents      DowntimeEvent[]
  notifications       Notification[]
  workOrderCounters   WorkOrderCounter[]

  @@map("organizations")
}

/// A hospital or site belonging to one organisation.
model Hospital {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  code           String // short code, unique inside the organisation, e.g. "RGH"
  timezone       String       @default("Africa/Nairobi")
  status         RecordStatus @default(ACTIVE)
  archivedAt     DateTime?    @map("archived_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  departments  Department[]
  scopes       MembershipScope[]
  locations    Location[]
  assets       Asset[]
  workOrders   WorkOrder[]

  @@unique([organizationId, code])
  @@unique([organizationId, id]) // target for composite foreign keys
  @@index([organizationId, status])
  @@map("hospitals")
}

/// A ward, unit or service inside a hospital, e.g. ICU.
model Department {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  hospitalId     String       @map("hospital_id") @db.Uuid
  name           String
  code           String
  status         RecordStatus @default(ACTIVE)
  archivedAt     DateTime?    @map("archived_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  // Composite FK: the hospital must belong to the SAME organisation.
  hospital     Hospital          @relation(fields: [organizationId, hospitalId], references: [organizationId, id], onDelete: Restrict)
  scopes       MembershipScope[]
  locations    Location[]
  assets       Asset[]
  workOrders   WorkOrder[]

  @@unique([organizationId, hospitalId, code])
  @@unique([organizationId, id])
  @@unique([organizationId, hospitalId, id])
  @@index([organizationId, hospitalId, status])
  @@map("departments")
}

// ─── Equipment (Stage 4) ─────────────────────────────────────────────────────
// Case-insensitive uniqueness rules (lower(name)), format checks and
// Row-Level Security live in the hand-written *_equipment_security migration.

/// A room, bay or store inside a department, e.g. "ICU Bay 3".
model Location {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  hospitalId     String       @map("hospital_id") @db.Uuid
  departmentId   String       @map("department_id") @db.Uuid
  name           String
  building       String?
  floor          String?
  status         RecordStatus @default(ACTIVE)
  archivedAt     DateTime?    @map("archived_at") @db.Timestamptz(6)
  createdById    String?      @map("created_by")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  hospital     Hospital     @relation(fields: [organizationId, hospitalId], references: [organizationId, id], onDelete: Restrict)
  // The department must belong to the same organisation AND hospital.
  department   Department   @relation(fields: [organizationId, hospitalId, departmentId], references: [organizationId, hospitalId, id], onDelete: Restrict)
  assets       Asset[]

  @@unique([organizationId, id])
  @@unique([organizationId, departmentId, id]) // lets an asset's location be forced into the asset's department
  @@index([organizationId, departmentId])
  @@map("locations")
}

/// A maker of equipment. One list per organisation.
model Manufacturer {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  country        String?      @db.Char(2)
  supportContact String?      @map("support_contact")
  status         RecordStatus @default(ACTIVE)
  archivedAt     DateTime?    @map("archived_at") @db.Timestamptz(6)
  createdById    String?      @map("created_by")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  models       EquipmentModel[]

  @@unique([organizationId, id])
  @@map("manufacturers")
}

/// A device type, e.g. "Infusion pump".
model EquipmentCategory {
  id                      String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId          String       @map("organization_id") @db.Uuid
  name                    String
  parentId                String?      @map("parent_id") @db.Uuid
  defaultRiskClass        RiskClass?   @map("default_risk_class")
  defaultPmIntervalMonths Int?         @map("default_pm_interval_months")
  /// Decision 9 (15 Oct 2026): jobs on safety-critical device types are
  /// flagged, given at least High priority and escalated immediately.
  safetyCritical          Boolean      @default(false) @map("safety_critical")
  status                  RecordStatus @default(ACTIVE)
  archivedAt              DateTime?    @map("archived_at") @db.Timestamptz(6)
  createdById             String?      @map("created_by")
  createdAt               DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parent       EquipmentCategory?  @relation("CategoryTree", fields: [organizationId, parentId], references: [organizationId, id], onDelete: Restrict)
  children     EquipmentCategory[] @relation("CategoryTree")
  models       EquipmentModel[]

  @@unique([organizationId, id])
  @@map("equipment_categories")
}

/// A make and model, e.g. manufacturer X, model "IP-200".
model EquipmentModel {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String       @map("organization_id") @db.Uuid
  manufacturerId    String       @map("manufacturer_id") @db.Uuid
  categoryId        String       @map("category_id") @db.Uuid
  modelName         String       @map("model_name")
  expectedLifeYears Int?         @map("expected_life_years")
  status            RecordStatus @default(ACTIVE)
  archivedAt        DateTime?    @map("archived_at") @db.Timestamptz(6)
  createdById       String?      @map("created_by")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  manufacturer Manufacturer      @relation(fields: [organizationId, manufacturerId], references: [organizationId, id], onDelete: Restrict)
  category     EquipmentCategory @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: Restrict)
  assets       Asset[]

  @@unique([organizationId, id])
  @@index([organizationId, categoryId])
  @@map("equipment_models")
}

/// One physical medical device. Never hard-deleted: archived instead, so its
/// history (and later its work orders and test records) is kept.
model Asset {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String      @map("organization_id") @db.Uuid
  hospitalId       String      @map("hospital_id") @db.Uuid
  departmentId     String      @map("department_id") @db.Uuid
  locationId       String?     @map("location_id") @db.Uuid
  modelId          String      @map("model_id") @db.Uuid
  /// Human-readable BiomedIntel.ai asset ID, e.g. "INF-0412". Unique per organisation.
  /// Printed on labels as text and as a Code 128 barcode.
  assetTag         String      @map("asset_tag")
  name             String
  /// Not unique: manufacturers reuse serial numbers across models and lines.
  serialNumber     String?     @map("serial_number")
  /// The hospital's own asset/inventory number, unique per hospital when present.
  inventoryNumber  String?     @map("inventory_number")
  description      String?
  supplier         String?
  status           AssetStatus @default(IN_SERVICE)
  riskClass        RiskClass?  @map("risk_class")
  purchaseDate     DateTime?   @map("purchase_date") @db.Date
  commissionedAt   DateTime?   @map("commissioned_at") @db.Date
  purchaseCost     Decimal?    @map("purchase_cost") @db.Decimal(14, 2)
  purchaseCurrency String?     @map("purchase_currency") @db.Char(3)
  eolDate          DateTime?   @map("eol_date") @db.Date
  archivedAt       DateTime?   @map("archived_at") @db.Timestamptz(6)
  archivedById     String?     @map("archived_by")
  createdById      String?     @map("created_by")
  updatedById      String?     @map("updated_by")
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  hospital        Hospital             @relation(fields: [organizationId, hospitalId], references: [organizationId, id], onDelete: Restrict)
  department      Department           @relation(fields: [organizationId, hospitalId, departmentId], references: [organizationId, hospitalId, id], onDelete: Restrict)
  location        Location?            @relation(fields: [organizationId, departmentId, locationId], references: [organizationId, departmentId, id], onDelete: Restrict)
  model           EquipmentModel       @relation(fields: [organizationId, modelId], references: [organizationId, id], onDelete: Restrict)
  statusHistory   AssetStatusHistory[]
  warranties      Warranty[]
  lifecycleEvents LifecycleEvent[]
  workOrders      WorkOrder[]
  downtimeEvents  DowntimeEvent[]

  @@unique([organizationId, assetTag])
  @@unique([organizationId, hospitalId, inventoryNumber])
  @@unique([organizationId, id])
  @@index([organizationId, hospitalId, departmentId, status])
  @@index([organizationId, modelId])
  @@index([organizationId, updatedAt(sort: Desc)])
  @@map("assets")
}

/// Every operational status change, for uptime reporting. Append-only.
model AssetStatusHistory {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  assetId        String       @map("asset_id") @db.Uuid
  fromStatus     AssetStatus? @map("from_status")
  toStatus       AssetStatus  @map("to_status")
  reason         String?
  changedById    String?      @map("changed_by")
  /// The work order that caused this change, if any (Stage 5).
  workOrderId    String?      @map("work_order_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  asset        Asset        @relation(fields: [organizationId, assetId], references: [organizationId, id], onDelete: Restrict)
  workOrder    WorkOrder?   @relation(fields: [organizationId, workOrderId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, assetId, createdAt])
  @@map("asset_status_history")
}

/// A warranty or service contract for one asset.
model Warranty {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  assetId        String       @map("asset_id") @db.Uuid
  kind           WarrantyKind @default(WARRANTY)
  provider       String
  startsOn       DateTime?    @map("starts_on") @db.Date
  endsOn         DateTime     @map("ends_on") @db.Date
  coverage       String?
  archivedAt     DateTime?    @map("archived_at") @db.Timestamptz(6)
  createdById    String?      @map("created_by")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  asset        Asset        @relation(fields: [organizationId, assetId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, endsOn])
  @@index([organizationId, assetId])
  @@map("warranties")
}

/// A lifecycle request and its decision. For DECOMMISSION: requested by a
/// technician, manager or admin; approved or rejected by the Department Head
/// (NUM) of the asset's department; never by the requester.
model LifecycleEvent {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  assetId        String               @map("asset_id") @db.Uuid
  eventType      LifecycleEventType   @map("event_type")
  status         LifecycleEventStatus @default(PENDING)
  reason         String
  effectiveOn    DateTime?            @map("effective_on") @db.Date
  requestedById  String               @map("requested_by")
  decidedById    String?              @map("decided_by")
  decidedAt      DateTime?            @map("decided_at") @db.Timestamptz(6)
  decisionNote   String?              @map("decision_note")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  asset        Asset        @relation(fields: [organizationId, assetId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, assetId, eventType])
  @@index([organizationId, status])
  @@map("lifecycle_events")
}

/// A job on one asset. Number like WO-2026-00001, unique per organisation.
/// Hospital and department are recorded when the job is reported, so later
/// asset moves do not change who may see an existing job.
model WorkOrder {
  id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String            @map("organization_id") @db.Uuid
  number                String
  assetId               String            @map("asset_id") @db.Uuid
  hospitalId            String            @map("hospital_id") @db.Uuid
  departmentId          String            @map("department_id") @db.Uuid
  type                  WorkOrderType     @default(CORRECTIVE)
  priority              WorkOrderPriority
  status                WorkOrderStatus   @default(REQUESTED)
  /// Snapshot at report time: safety-critical category or High-risk asset.
  safetyCritical        Boolean           @default(false) @map("safety_critical")
  /// The reporter took the device out of use.
  outOfUse              Boolean           @default(false) @map("out_of_use")
  faultDescription      String            @map("fault_description")
  reportedById          String            @map("reported_by")
  assignedToId          String?           @map("assigned_to")
  assignedById          String?           @map("assigned_by")
  assignedAt            DateTime?         @map("assigned_at") @db.Timestamptz(6)
  dueAt                 DateTime?         @map("due_at") @db.Timestamptz(6)
  startedAt             DateTime?         @map("started_at") @db.Timestamptz(6)
  holdReason            String?           @map("hold_reason")
  diagnosis             String?
  resolution            String?
  outcome               WorkOrderOutcome?
  functionalCheck       CheckResult?      @map("functional_check")
  electricalSafetyCheck CheckResult?      @map("electrical_safety_check")
  checkNotes            String?           @map("check_notes")
  /// The technician's declaration that the checks and results are their own.
  signOffDeclaration    Boolean           @default(false) @map("sign_off_declaration")
  completedById         String?           @map("completed_by")
  completedAt           DateTime?         @map("completed_at") @db.Timestamptz(6)
  /// Optional manager review after a technician's sign-off (never blocking).
  reviewedById          String?           @map("reviewed_by")
  reviewedAt            DateTime?         @map("reviewed_at") @db.Timestamptz(6)
  cancelledById         String?           @map("cancelled_by")
  cancelledAt           DateTime?         @map("cancelled_at") @db.Timestamptz(6)
  cancelReason          String?           @map("cancel_reason")
  reopenCount           Int               @default(0) @map("reopen_count")
  updatedById           String?           @map("updated_by")
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  asset         Asset                @relation(fields: [organizationId, assetId], references: [organizationId, id], onDelete: Restrict)
  hospital      Hospital             @relation(fields: [organizationId, hospitalId], references: [organizationId, id], onDelete: Restrict)
  department    Department           @relation(fields: [organizationId, hospitalId, departmentId], references: [organizationId, hospitalId, id], onDelete: Restrict)
  events        WorkOrderEvent[]
  tasks         WorkOrderTask[]
  attachments   Attachment[]
  downtime      DowntimeEvent[]
  statusChanges AssetStatusHistory[]

  @@unique([organizationId, number])
  @@unique([organizationId, id])
  @@index([organizationId, status, priority])
  @@index([organizationId, assignedToId, status])
  @@index([organizationId, assetId, status])
  @@index([organizationId, hospitalId, departmentId, status])
  @@map("work_orders")
}

/// Next work order number per organisation and year (WO-2026-00001 …).
model WorkOrderCounter {
  organizationId String @map("organization_id") @db.Uuid
  year           Int
  lastNumber     Int    @default(0) @map("last_number")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@id([organizationId, year])
  @@map("work_order_counters")
}

/// Timeline of a work order. Append-only.
model WorkOrderEvent {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  workOrderId    String           @map("work_order_id") @db.Uuid
  kind           String // CREATED, ASSIGNED, STARTED, ON_HOLD, NOTE, COMPLETED, REOPENED, …
  fromStatus     WorkOrderStatus? @map("from_status")
  toStatus       WorkOrderStatus? @map("to_status")
  note           String?
  actorId        String           @map("actor_id")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workOrder    WorkOrder    @relation(fields: [organizationId, workOrderId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, workOrderId, createdAt])
  @@map("work_order_events")
}

/// Work done on a job (Stage 2 work_order_tasks): what was done and how long.
/// Append-only: corrections are new entries.
model WorkOrderTask {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  workOrderId    String   @map("work_order_id") @db.Uuid
  description    String
  minutes        Int
  performedById  String   @map("performed_by")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workOrder    WorkOrder    @relation(fields: [organizationId, workOrderId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, workOrderId, createdAt])
  @@map("work_order_tasks")
}

/// A photo on a work order. Stored in the database for now (decision of
/// 15 Oct 2026); re-encoded on upload so camera and location metadata are removed.
model Attachment {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  entityType     String   @default("work_order") @map("entity_type")
  workOrderId    String   @map("work_order_id") @db.Uuid
  filename       String
  mime           String
  sizeBytes      Int      @map("size_bytes")
  sha256         String
  width          Int
  height         Int
  content        Bytes
  uploadedById   String   @map("uploaded_by")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workOrder    WorkOrder    @relation(fields: [organizationId, workOrderId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, workOrderId])
  @@map("attachments")
}

/// When a device was unavailable, for uptime reporting.
model DowntimeEvent {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  assetId        String    @map("asset_id") @db.Uuid
  workOrderId    String?   @map("work_order_id") @db.Uuid
  startedAt      DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt        DateTime? @map("ended_at") @db.Timestamptz(6)
  reason         String
  planned        Boolean   @default(false)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  asset        Asset        @relation(fields: [organizationId, assetId], references: [organizationId, id], onDelete: Restrict)
  workOrder    WorkOrder?   @relation(fields: [organizationId, workOrderId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, assetId, startedAt])
  @@map("downtime_events")
}

/// In-app notification for one person in one organisation.
model Notification {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id")
  type           String // e.g. workorder.reported, workorder.assigned
  entityType     String?   @map("entity_type")
  entityId       String?   @map("entity_id")
  title          String
  body           String?
  /// In-app path only, e.g. /work-orders/<id>
  link           String?
  readAt         DateTime? @map("read_at") @db.Timestamptz(6)
  emailedAt      DateTime? @map("emailed_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, userId, readAt])
  @@map("notifications")
}

// ─── People and access ───────────────────────────────────────────────────────

/// Links a user to one organisation with one role.
/// `orgWide = true` gives access to every hospital in the organisation;
/// otherwise access comes only from `membership_scopes`.
model Membership {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id")
  role           MembershipRole
  orgWide        Boolean          @default(false) @map("org_wide")
  status         MembershipStatus @default(ACTIVE)
  createdById    String?          @map("created_by")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  scopes       MembershipScope[]

  @@unique([organizationId, userId])
  @@unique([organizationId, id])
  @@index([userId, status])
  @@map("memberships")
}

/// One hospital (and optionally one department) a membership may access.
/// department_id NULL means "all departments in this hospital".
/// Uniqueness (membership, hospital, department) with NULLS NOT DISTINCT is
/// added in the security migration because Prisma cannot express it.
model MembershipScope {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  membershipId   String   @map("membership_id") @db.Uuid
  hospitalId     String   @map("hospital_id") @db.Uuid
  departmentId   String?  @map("department_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  membership   Membership   @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Cascade)
  hospital     Hospital     @relation(fields: [organizationId, hospitalId], references: [organizationId, id], onDelete: Restrict)
  // Composite FK: the department must belong to the SAME organisation AND the SAME hospital.
  department   Department?  @relation(fields: [organizationId, hospitalId, departmentId], references: [organizationId, hospitalId, id], onDelete: Restrict)

  @@index([organizationId, membershipId])
  @@map("membership_scopes")
}

// ─── Audit ───────────────────────────────────────────────────────────────────

/// Append-only record of important actions. The database rejects UPDATE,
/// DELETE and TRUNCATE on this table, and the app role is only granted
/// SELECT and INSERT. No `updated_at`, because rows never change.
model AuditLog {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?      @map("organization_id") @db.Uuid // NULL for platform or sign-in events
  actorUserId    String?      @map("actor_user_id") // no FK: the record must outlive any user change
  action         String // e.g. "hospital.created", "authz.denied", "auth.sign_in"
  outcome        AuditOutcome @default(SUCCESS)
  entityType     String?      @map("entity_type")
  entityId       String?      @map("entity_id")
  metadata       Json? // small, non-sensitive details; never passwords or tokens
  ipAddress      String?      @map("ip_address")
  userAgent      String?      @map("user_agent")
  requestId      String?      @map("request_id")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, entityType, entityId])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ─── Authentication (managed by Better Auth) ─────────────────────────────────
// Global tables: a person has ONE login, and memberships connect it to
// organisations. These tables have no organization_id and no RLS; the app
// reaches them only through Better Auth and the access-resolution code.

model User {
  id               String   @id
  name             String
  email            String   @unique
  emailVerified    Boolean  @default(false) @map("email_verified")
  image            String?
  twoFactorEnabled Boolean? @default(false) @map("two_factor_enabled")
  /// "SUPER_ADMIN" for the Platform Super Administrator, otherwise NULL.
  /// Set only by `npm run admin:bootstrap`; users can never set it themselves.
  platformRole     String?  @map("platform_role")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions    Session[]
  accounts    Account[]
  twoFactors  TwoFactor[]
  memberships Membership[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  token     String   @unique
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  password              String? // scrypt hash written by Better Auth; never plain text
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@map("auth_verifications")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String    @map("backup_codes")
  userId                  String    @map("user_id")
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
  @@map("auth_two_factors")
}
