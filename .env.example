# BiomedIntel.ai environment settings
# Copy this file to `.env` for local development and fill in your own values.
# `.env` is excluded from Git. Never commit real passwords, secrets or keys.

# ── Database ────────────────────────────────────────────────────────────────
# Used by the running web application. MUST be the restricted `biomedintel_app`
# role (NOBYPASSRLS) so Row-Level Security protects every tenant table.
DATABASE_URL="postgresql://biomedintel_app:CHANGE_ME@localhost:5432/biomedintel_dev"

# Used ONLY by migrations, seeding and admin scripts (`biomedintel_owner`).
# Never give this URL to the web application.
DATABASE_URL_ADMIN="postgresql://biomedintel_owner:CHANGE_ME@localhost:5432/biomedintel_dev"

# Test database (must end in _test; the test suite refuses any other name).
DATABASE_URL_TEST="postgresql://biomedintel_app:CHANGE_ME@localhost:5432/biomedintel_test"
DATABASE_URL_ADMIN_TEST="postgresql://biomedintel_owner:CHANGE_ME@localhost:5432/biomedintel_test"

# ── Authentication (Better Auth) ────────────────────────────────────────────
# A long random secret used to sign session cookies. Generate one with:
#   openssl rand -base64 32
# Use a DIFFERENT secret in every environment (development, staging, production).
BETTER_AUTH_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_VALUE"

# The public address of the app. Local: http://localhost:3000
BETTER_AUTH_URL="http://localhost:3000"


# Require authenticator-app MFA for Platform Super Administrators,
# Organization Administrators and Biomedical Engineering Managers.
# Keep "true". Only set "false" temporarily for local troubleshooting.
REQUIRE_MFA_FOR_PRIVILEGED_ROLES="true"

# ── Development seed data ───────────────────────────────────────────────────
# Password given to the fictional seed users (local development only, 12+ characters).
SEED_USER_PASSWORD="CHANGE_ME_local_seed_password"

# First Platform Super Administrator (used once by `npm run admin:bootstrap`).
# Leave the password empty to be prompted instead.
BOOTSTRAP_ADMIN_EMAIL="admin@biomedintel.example"
BOOTSTRAP_ADMIN_NAME="Platform Administrator"
BOOTSTRAP_ADMIN_PASSWORD=""

# ── Preventive maintenance scheduler (Stage 6) ──────────────────────────────
# Optional. Switches on POST /api/cron/pm-generate for a daily scheduler, which
# must send the header:  Authorization: Bearer <CRON_SECRET>
# Generate one with:  openssl rand -base64 32     Leave empty to keep it off.
# You can always run generation by hand with:  npm run pm:generate
CRON_SECRET=""

# ── IntellAssist AI suggestions (Stage 9) ───────────────────────────────────
# Optional. With AI_PROVIDER empty, AI suggestions are unavailable and every
# other feature (including the knowledge base and manual troubleshooting)
# works normally. An Organisation Administrator must also switch AI on in
# IntellAssist → AI settings. Keys stay on the server and are never sent to
# browsers, logs or API responses.
#   AI_PROVIDER="anthropic"  uses the Claude Messages API (paid; needs a key)
#   AI_PROVIDER="mock"       deterministic test stand-in, labelled "Mock AI" — never for real use
AI_PROVIDER=""
# Model name when AI_PROVIDER="anthropic", for example claude-sonnet-5-5.
AI_MODEL=""
# Your Claude API key (from the Claude Console). Set a spend limit on the account.
ANTHROPIC_API_KEY=""
# Optional override of the API address (leave empty for https://api.anthropic.com).
AI_BASE_URL=""
# Limits (defaults shown).
AI_TIMEOUT_MS="60000"
AI_MAX_OUTPUT_TOKENS="2000"
AI_USER_HOURLY_LIMIT="20"
AI_ORG_DAILY_LIMIT="200"
AI_ORG_MONTHLY_TOKEN_LIMIT="2000000"
